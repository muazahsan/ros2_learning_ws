<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>turtle_formation</name>
  <version>0.0.1</version>
  <description>Shape-shifting multi-robot formation swarm in ROS 2 turtlesim</description>
  <maintainer email="muaz@example.com">muaz</maintainer>
